{
  "name": "interview-copilot",
  "version": "1.2.3",
  "private": true,
  "description": "Mac 上的实时面试辅助工作台",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
