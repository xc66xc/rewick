    "pack": "node scripts/package.mjs mac dir arm64",
    "dist": "node scripts/package.mjs mac dmg arm64",
    "pack:win": "node scripts/package.mjs win dir x64",
    "dist:win": "node scripts/package.mjs win nsis x64",
    "test:rag": "node scripts/smoke-rag.mjs",
    "test:environments": "node scripts/smoke-environments.mjs",
    "test:remote-knowledge": "node scripts/smoke-remote-knowledge.mjs",
    "test:history": "node scripts/smoke-history.mjs",
    "test:operations": "node scripts/smoke-operations.mjs",
    "test:platform": "node scripts/smoke-platform.mjs",
    "test:accounts": "node scripts/smoke-account-isolation.mjs",
    "prepare:recording": "node scripts/prepare-recording-python.mjs",
    "predev": "npm run prepare:recording",
    "test:hybrid": "node scripts/smoke-reference-hybrid.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "undici": "7.29.1",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
