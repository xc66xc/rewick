{
  "name": "interview-copilot",
  "version": "0.4.0",
  "private": true,
  "description": "Mac 上的实时面试辅助工作台",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.mjs",
    "pack": "npm run build && electron-builder --mac dir --arm64",
    "dist": "npm run build && electron-builder --mac dmg --arm64",
    "test:rag": "node scripts/smoke-rag.mjs",
    "test:environments": "node scripts/smoke-environments.mjs",
    "test:remote-knowledge": "node scripts/smoke-remote-knowledge.mjs",
    "test:history": "node scripts/smoke-history.mjs",
    "test:platform": "node scripts/smoke-platform.mjs",
    "test:accounts": "node scripts/smoke-account-isolation.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.18"
  }
}
