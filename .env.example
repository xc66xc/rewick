# Only the Java backend reads these variables. Never bundle this file with Electron.
# Set a strong database password before running docker compose.
COPILOT_DATABASE_PASSWORD=
COPILOT_HTTP_PORT=8080

# Optional first account: 3–64 ASCII username characters; password >=12 characters, <=72 UTF-8 bytes.
# No built-in account or password. Remove these values after the account is created.
COPILOT_BOOTSTRAP_USERNAME=
COPILOT_BOOTSTRAP_PASSWORD=

# Complete Chat Completions endpoint; configuration of URL, Key and model enables this capability.
COPILOT_PROVIDERS_LLM_URL=
COPILOT_PROVIDERS_LLM_APIKEY=
COPILOT_PROVIDERS_LLM_MODEL=

# Example ASR URL: wss://dashscope.aliyuncs.com/api-ws/v1/inference
COPILOT_PROVIDERS_ASR_URL=
COPILOT_PROVIDERS_ASR_APIKEY=
COPILOT_PROVIDERS_ASR_MODEL=fun-asr-realtime

# Full Bailian knowledge search endpoint and the published Agent ID, owned by the server.
COPILOT_PROVIDERS_KNOWLEDGE_URL=
COPILOT_PROVIDERS_KNOWLEDGE_APIKEY=
COPILOT_PROVIDERS_KNOWLEDGE_AGENTID=

# Resource protection limits; these are not money prices or a payment system.
COPILOT_DAILY_ANSWERS=100
COPILOT_DAILY_KNOWLEDGE_QUERIES=300
COPILOT_MAX_ASR_SESSION_SECONDS=3600
