# Server-side and Compose configuration. Never bundle this file with desktop or Web clients.
# Compose builds PostgreSQL 15.19 + pgvector 0.5.1 from deploy/postgres/.
# Set a strong database password before running docker compose.
COPILOT_DATABASE_PASSWORD=
COPILOT_HTTP_PORT=8080
COPILOT_ADMIN_PORT=5174

# Separate initial administrator; never promotes an existing ordinary user.
COPILOT_ADMIN_BOOTSTRAP_USERNAME=
COPILOT_ADMIN_BOOTSTRAP_PASSWORD=

# Required for publishing platform configuration: Base64-encoded 32 random bytes.
# Generate once with openssl rand -base64 32; keep a secure backup outside the database.
# Do not change this key after saving encrypted provider credentials.
COPILOT_PLATFORM_MASTER_KEY=

# Optional first account: 3–64 ASCII username characters; password >=12 characters, <=72 UTF-8 bytes.
# No built-in account or password. Remove these values after the account is created.
COPILOT_BOOTSTRAP_USERNAME=
COPILOT_BOOTSTRAP_PASSWORD=

# Separate Base64-encoded 32-byte secret for hashing email verification codes.
# Generate once with openssl rand -base64 32; do not put it in the database.
COPILOT_EMAIL_CODE_SECRET=
# Emergency registration switch; SMTP must also be enabled in the admin UI.
COPILOT_EMAIL_REGISTRATION_ENABLED=true

# Model, ASR, knowledge and SMTP endpoints/credentials are configured in the admin UI.
# They are stored in the database; no provider URL/Key environment fallback is used.

# Resource protection limits; these are not money prices or a payment system.
COPILOT_DAILY_ANSWERS=100
COPILOT_DAILY_KNOWLEDGE_QUERIES=300
COPILOT_MAX_ASR_SESSION_SECONDS=3600
